# Required: create a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Recommended for live Google Flights and Google Hotels results
SERPAPI_API_KEY=your_serpapi_key

# Optional: powers live destination and attraction web research
TAVILY_API_KEY=your_tavily_api_key

# Optional runtime controls
REQUEST_TIMEOUT_SECONDS=30
PLANNER_TIMEOUT_SECONDS=55
GROQ_MAX_OUTPUT_TOKENS=1536
GROQ_TPM_BUDGET=8000
# MAX_AGENT_STEPS is retired: one batch of searches, then a final answer.
