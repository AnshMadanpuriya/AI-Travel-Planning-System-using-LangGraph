# Safe mode works without third-party credentials.
TRAVEL_AGENT_DEMO_MODE=true

# Required to enable live AI itinerary composition.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional live research providers.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=

# Used by the Python FastMCP weather server. The hosted edge UI uses Open-Meteo.
OPENWEATHER_API_KEY=

# Optional Python LangGraph checkpoint storage outside Docker Compose.
DATABASE_URL=

# Docker Compose database values. Change the password outside local development.
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=travel_agent
