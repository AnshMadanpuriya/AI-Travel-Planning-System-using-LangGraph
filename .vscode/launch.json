{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VoyageGraph: Streamlit UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "frontend.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "VoyageGraph: CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "VoyageGraph: MCP Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp_server.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

